{
  "name": "senate-caucus-support-vanhollen",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.js",
  "license": "CC0-1.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test *.test.js",
    "desktop": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "org.senatecaucus.formhelper",
    "productName": "Senate Form Helper",
    "files": [
      "desktop/**",
      "export-data.js",
      "senators.js",
      "package.json"
    ],
    "mac": {
      "target": [
        "zip"
      ],
      "identity": null
    },
    "win": {
      "target": [
        "portable"
      ]
    }
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  }
}
